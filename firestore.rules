rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email == 'admin@dineshonline.in');
    }

    function isOwner(mobileOrUid) {
      return isAuthenticated() && (request.auth.uid == mobileOrUid || request.auth.token.phone_number == ('+91' + mobileOrUid));
    }

    // Services collection: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users profile: Owner read/write, Admin read/write
    match /users/{mobile} {
      allow read, write: if isAuthenticated() && (isOwner(mobile) || isAdmin());
      allow create: if true; // Registration
    }

    // PIN Credentials: NEVER ACCESSIBLE FROM CLIENT FRONTEND
    match /pinCredentials/{mobile} {
      allow read, write: if false; // Server-side Cloud Functions only
    }

    // Applications: Customer owner can read their own, Admin can read/write all
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.customerMobile == request.auth.token.phone_number || isAdmin());
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAdmin();
    }

    // Payments: Verified read by customer or admin, written by Cloud Functions
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.customerMobile == request.auth.token.phone_number || isAdmin());
      allow write: if isAdmin();
    }

    // Support Tickets: Owner or Admin
    match /supportTickets/{ticketId} {
      allow read, write: if isAuthenticated() && (resource.data.mobile == request.auth.token.phone_number || isAdmin());
      allow create: if true;
    }

    // Admin Logs: Admin only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

